# Apache configuration per SPA - React Router
# Serve sempre index.html per tutte le route che non sono file esistenti

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  
  # Se la richiesta è per un file esistente, servilo direttamente
  RewriteCond %{REQUEST_FILENAME} !-f
  # Se la richiesta è per una directory esistente, servila
  RewriteCond %{REQUEST_FILENAME} !-d
  # Se la richiesta NON è per index.html, reindirizza a index.html
  RewriteCond %{REQUEST_URI} !^/index\.html$
  # Se la richiesta è per /index (senza .html), reindirizza a /index.html
  RewriteCond %{REQUEST_URI} ^/index$
  RewriteRule ^ /index.html [L,R=301]
  # Reindirizza tutto il resto a index.html (mantiene query string)
  RewriteRule ^ /index.html [L]
</IfModule>

# Headers per sicurezza e performance
<IfModule mod_headers.c>
  # Cache per assets statici
  <FilesMatch "\.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  
  # No cache per index.html (per aggiornamenti)
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>


