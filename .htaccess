# Apache configuration per SPA - React Router
# Serve sempre index.html per tutte le route che non sono file esistenti

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  
  # Se la richiesta è per un file esistente (escluso index.html), servilo direttamente
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteCond %{REQUEST_URI} !^/index\.html$
  RewriteRule . - [L]
  
  # Se la richiesta è per una directory esistente, servila
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule . - [L]
  
  # Per tutte le altre richieste, reindirizza a index.html (mantiene query string)
  # Questo permette a React Router di gestire il routing lato client
  RewriteCond %{REQUEST_URI} !^/index\.html$
  RewriteRule ^ /index.html [L]
</IfModule>

# Fallback per server che non supportano mod_rewrite
# Reindirizza 404 a index.html
ErrorDocument 404 /index.html

# Headers per sicurezza e performance
<IfModule mod_headers.c>
  # Cache per assets statici
  <FilesMatch "\.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  
  # No cache per index.html (per aggiornamenti)
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>


